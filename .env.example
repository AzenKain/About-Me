# ==============================================================================
# Self-Hosted VPS Environment Configuration
# ==============================================================================

# Server Port & Host
PORT=3000
HOSTNAME=0.0.0.0

# Database (Pure Local SQLite on Disk - stored in data/ folder)
DATABASE_URL=file:data/portfolio.db

# Master Passkey for Admin CMS Login (Recommended: hashed passkey with salt)
# Generate with: bun run hash-passkey "your_password"
ADMIN_PASSKEY_HASH=
# Or plaintext fallback (not recommended for production):
# ADMIN_PASSKEY=change_this_to_your_secure_password_123

# Session Encryption Key (Minimum 32 random characters)
SESSION_SECRET=generate_a_random_32_character_hex_string_here

# Automated GitHub Sync (VPS/Docker Internal Cron or Vercel Cron)
# On VPS/Docker: Background sync interval & auto-sync toggle are managed directly in the
# Admin UI (Git Repositories tab) and stored in SQLite.
# Optional kill-switch to disable internal scheduler completely:
# ENABLE_INTERNAL_CRON=false
#
# For Vercel or external curl trigger, set CRON_SECRET:
# CRON_SECRET=generate_a_random_token_for_cron_jobs
# GITHUB_TOKEN=your_personal_access_token_for_higher_api_limits

# Optional: GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ADMIN_GITHUB_USERNAME=your_username
